print("✅ Setup completed")
import cv2
import math
import numpy as np
from collections import defaultdict
from ultralytics import YOLO
import supervision as sv
from google.colab import files
import time

model = YOLO("yolov8x.pt")
print("✅ Model loaded")

print("📤 Upload short video")
uploaded = files.upload()
video_path = list(uploaded.keys())[0]

print("🚀 Processing...")

tracker = sv.ByteTrack()
analytics = defaultdict(lambda: {"dist_m": 0.0, "touches": 0})
last_pos = {}
frame_count = 0

generator = sv.get_video_frames_generator(video_path)

for frame in generator:
    frame_count += 1
    results = model(frame, verbose=False)[0]
    detections = sv.Detections.from_ultralytics(results)

    player_dets = detections[detections.class_id == 0]
    tracked = tracker.update_with_detections(player_dets)

    # Ball - Try all possible class IDs
    ball_pos = None
    for cls in [2, 32, 0, 1]:  # Common ball class IDs
        ball_dets = detections[detections.class_id == cls]
        if len(ball_dets) > 0:
            ball_pos = ((ball_dets.xyxy[0][0] + ball_dets.xyxy[0][2]) / 2, ball_dets.xyxy[0][3])
            break

    current_players = {}
    tracker_ids = tracked.tracker_id
    if tracker_ids is not None:
        for i, track_id in enumerate(tracker_ids):
            if track_id is not None:
                xyxy = tracked.xyxy[i]
                px = (xyxy[0] + xyxy[2]) / 2
                py = xyxy[3]
                current_players[track_id] = (px, py)

                if track_id in last_pos:
                    dist = math.hypot(px - last_pos[track_id][0], py - last_pos[track_id][1])
                    analytics[track_id]["dist_m"] += dist * 0.1
                last_pos[track_id] = (px, py)

    # Ball touches - Very aggressive
    if ball_pos and current_players:
        bx, by = ball_pos
        closest = None
        min_d = float('inf')
        for tid, (px, py) in current_players.items():
            d = math.hypot(px - bx, py - by)
            if d < 12.0 and d < min_d:   # Very wide
                closest = tid
                min_d = d
        if closest:
            analytics[closest]["touches"] += 1

print(f"\n✅ Done! Processed {frame_count} frames")
print(f"Unique players tracked: {len(analytics)}")

sorted_players = sorted(analytics.items(), key=lambda x: x[1]["dist_m"], reverse=True)[:22]

print("\n=== FINAL STATS ===")
for tid, stats in sorted_players:
    print(f"Player {tid}: Distance {round(stats['dist_m']/1000, 2)} km, Touches {stats['touches']}")
